 },
 {
  "id": "photo/new-angle",
  "name": "New angle",
  "output": "image",
  "description": "Re-shoot a photo from another camera position while keeping everything in it the same.",
  "inputs": [
   {
    "key": "photo",
    "label": "Photo",
    "kind": "image",
    "max": 1,
    "required": true
   }
  ],
  "fields": [
   {
    "key": "angle",
    "label": "New camera position",
    "type": "enum",
    "options": [
     "a low angle",
     "a high angle",
     "the left side",
     "the right side",
     "behind the subject",
     "a bird's-eye view",
     "a close-up",
     "a wide establishing view"
    ],
    "default": "a low angle"
   }
  ],
  "steps": [
   {
    "id": "angle",
    "label": "Re-shoot",
    "output": "image",
    "models": [
     "fal:google/nano-banana-2.1/edit",
     "fal:openai/gpt-image-2.5/sunburst/edit",
     "fal:bytedance/seedream/v5/flash/edit",
     "fal:alibaba/qwen-image-3/edit",
     "fal:blackforestlabs/flux-3/klein/edit-image",
     "comfyui:flux3-klein-edit",
     "mock:image"
    ],
    "prompt": "Show exactly the same scene from {{angle}}. Keep every person, object, material, color and the lighting identical; only the camera position changes.",
    "inputs": [
     {
      "role": "reference",
      "from": "input:photo"
     }
    ]
   }
  ]
 },
