     "fal:kling/v4/image-to-video",
     "fal:lightricks/ltx-2.5/image-to-video/pro",
     "fal:alibaba/wan-3.0-prime/image-to-video",
     "fal:fal-ai/minimax/hailuo-2.3/pro/image-to-video",
