          "label": "1:1"
        },
        {
          "value": "4:5",
          "label": "4:5"
        },
        {
          "value": "3:4",
          "label": "3:4"
        },
        {
          "value": "2:3",
          "label": "2:3"
        },
        {
          "value": "9:16",
          "label": "9:16"
        },
        {
          "value": "16:9",
          "label": "16:9"
        },
        {
          "value": "3:2",
          "label": "3:2"
        },
        {
          "value": "4:3",
          "label": "4:3"
        },
        {
          "value": "5:4",
          "label": "5:4"
        },
        {
          "value": "21:9",
          "label": "21:9"
        }
