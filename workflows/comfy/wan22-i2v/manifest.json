{
  "schema": 1,
  "name": "Wan 2.2 Image to Video",
  "description": "Alibaba Wan 2.2 14B image to video (fp8 high-noise and low-noise experts) at 16 fps. The 4-step lightx2v LoRAs are on by default; turn them off for the full 20-step run. About 38 GB of weights; ComfyUI offloads them on 12 GB GPUs.",
  "vendor": "Alibaba",
  "output": "video",
  "tasks": ["image_to_video"],
  "open_weights": true,
  "license": "Apache-2.0",
  "prompt": [["9", "text"]],
  "negative_prompt": [["7", "text"]],
  "inputs": [
    {
      "role": "start_frame",
      "kind": "image",
      "nodes": ["1"],
      "input": "image",
      "min": 1,
      "label": "Start frame"
    }
  ],
  "params": [
    {
      "key": "aspect_ratio",
      "label": "Aspect ratio",
      "type": "enum",
      "options": [
        {
          "value": "auto",
          "label": "Match input"
        },
        {
          "value": "16:9",
          "label": "16:9"
        },
        {
          "value": "9:16",
          "label": "9:16"
        },
        {
          "value": "1:1",
          "label": "1:1"
        }
      ],
      "default": "auto"
    },
    {
      "key": "resolution",
      "label": "Resolution",
      "type": "enum",
      "options": [
        {
          "value": "480p",
          "label": "480p"
        },
        {
          "value": "720p",
          "label": "720p"
        }
      ],
      "default": "480p"
    },
    {
      "key": "duration",
      "label": "Duration",
      "type": "enum",
      "options": [
        {
          "value": 2,
          "label": "2s"
        },
        {
          "value": 3,
          "label": "3s"
        },
        {
          "value": 4,
          "label": "4s"
        },
        {
          "value": 5,
          "label": "5s"
        }
      ],
      "default": 5,
      "bind": [["30", "value"]]
    },
    {
      "key": "lightning",
      "label": "Fast 4-step LoRA",
      "type": "bool",
      "default": true,
      "advanced": true,
      "help": "Runs 4 steps with the lightx2v LoRAs instead of 20 full steps.",
      "bind": [["29", "value"]]
    },
    {
      "key": "seed",
      "label": "Seed",
      "type": "seed",
      "advanced": true,
      "bind": [["5", "noise_seed"]]
    }
  ],
  "size": {
    "width": [["13", "width"]],
    "height": [["13", "height"]],
    "megapixels": 0.4,
    "multiple": 16,
    "resolutions": {
      "480p": 0.4,
      "720p": 0.92
    },
    "match_input": "start_frame"
  },
  "max_outputs": 1,
  "outputs": ["2"],
  "requires": {
    "nodes": [
      "CLIPLoader",
      "CLIPTextEncode",
      "ComfyMathExpression",
      "ComfySwitchNode",
      "CreateVideo",
      "KSamplerAdvanced",
      "LoadImage",
      "LoraLoaderModelOnly",
      "ModelSamplingSD3",
      "PrimitiveBoolean",
      "PrimitiveFloat",
      "PrimitiveInt",
      "SaveVideo",
      "UNETLoader",
      "VAEDecode",
      "VAELoader",
      "WanImageToVideo"
    ],
