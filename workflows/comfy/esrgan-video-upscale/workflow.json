{
  "1": {
    "inputs": {
      "model_name": "RealESRGAN_x4plus.safetensors"
    },
    "class_type": "UpscaleModelLoader",
    "_meta": {
      "title": "Load Upscale Model"
    }
  },
  "2": {
    "inputs": {
      "upscale_model": ["1", 0],
      "image": ["4", 0]
    },
    "class_type": "ImageUpscaleWithModel",
    "_meta": {
      "title": "Upscale Image (using Model)"
    }
  },
  "3": {
    "inputs": {
      "file": "input.mp4"
    },
    "class_type": "LoadVideo",
    "_meta": {
      "title": "Load Video"
    }
  },
  "4": {
    "inputs": {
      "video": ["3", 0]
    },
    "class_type": "GetVideoComponents",
    "_meta": {
      "title": "Get Video Components"
    }
  },
  "5": {
    "inputs": {
      "fps": ["4", 2],
      "bit_depth": "auto",
      "color_space": "sRGB",
      "codec": "none",
      "images": ["2", 0],
      "audio": ["4", 1]
    },
    "class_type": "CreateVideo",
    "_meta": {
      "title": "Create Video"
    }
  },
  "6": {
    "inputs": {
      "filename_prefix": "pictesa/upscale-video",
      "format": "auto",
      "format.codec": "auto",
      "codec": "auto",
      "video": ["5", 0]
    },
    "class_type": "SaveVideo",
    "_meta": {
      "title": "Save Video"
    }
  }
}
