{
  "schema": 1,
  "name": "LTX-2.5",
  "description": "Lightricks LTX-2.5 22B distilled (int8): text to video with synchronized audio, rendered at half size and upscaled 2x in latent space. About 40 GB of weights; ComfyUI streams them on 12 GB GPUs.",
  "vendor": "Lightricks",
  "output": "video",
  "tasks": ["text_to_video"],
  "open_weights": true,
  "license": "LTX-2.x Community License Agreement (gated on Hugging Face: request access before downloading)",
  "prompt": [["17", "text"]],
  "negative_prompt": [["26", "text"]],
  "params": [
    {
      "key": "aspect_ratio",
      "label": "Aspect ratio",
      "type": "enum",
      "options": [
        {
          "value": "16:9",
          "label": "16:9"
        },
        {
          "value": "9:16",
          "label": "9:16"
        },
        {
          "value": "1:1",
          "label": "1:1"
        }
      ],
      "default": "16:9"
    },
    {
      "key": "resolution",
      "label": "Resolution",
      "type": "enum",
      "options": [
        {
          "value": "540p",
          "label": "540p"
        },
        {
          "value": "720p",
          "label": "720p"
        },
        {
          "value": "1080p",
          "label": "1080p"
        }
      ],
      "default": "720p"
    },
    {
      "key": "duration",
      "label": "Duration",
      "type": "enum",
      "options": [
        {
          "value": 3,
          "label": "3s"
        },
        {
          "value": 5,
          "label": "5s"
        },
        {
          "value": 8,
          "label": "8s"
        },
        {
          "value": 10,
          "label": "10s"
        }
      ],
      "default": 5,
      "bind": [["16", "value"]]
    },
    {
      "key": "fps",
      "label": "Frame rate",
      "type": "enum",
      "options": [
        {
          "value": 24,
          "label": "24 fps"
        },
        {
          "value": 25,
          "label": "25 fps"
        },
        {
          "value": 48,
          "label": "48 fps"
        },
        {
          "value": 50,
          "label": "50 fps"
        }
      ],
      "default": 24,
      "advanced": true,
      "bind": [["15", "value"]]
    },
    {
      "key": "seed",
      "label": "Seed",
      "type": "seed",
      "advanced": true,
      "bind": [["3", "noise_seed"], ["2", "noise_seed"]]
    }
  ],
  "size": {
    "width": [["25", "value"]],
    "height": [["14", "value"]],
    "megapixels": 0.9,
    "multiple": 64,
    "resolutions": {
      "540p": 540,
      "720p": 720,
      "1080p": 1080
    }
  },
  "max_outputs": 1,
  "outputs": ["1"],
  "requires": {
    "nodes": [
      "CLIPLoader",
      "CLIPTextEncode",
      "ComfyMathExpression",
      "CreateVideo",
      "EmptyLTXVLatentVideo",
      "KSamplerSelect",
      "LTXVAudioVAEDecode",
      "LTXVConcatAVLatent",
      "LTXVConditioning",
      "LTXVDualCFGGuider",
      "LTXVEmptyLatentAudio",
      "LTXVLatentUpsampler",
      "LTXVSeparateAVLatent",
      "LatentUpscaleModelLoader",
      "ManualSigmas",
      "PrimitiveInt",
      "RandomNoise",
      "SamplerCustomAdvanced",
      "SaveVideo",
      "UNETLoader",
      "VAEDecodeTiled",
      "VAELoader"
    ],
    "models": [
      {
        "name": "gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors",
        "directory": "text_encoders",
        "url": "https://huggingface.co/Lightricks/LTX-2.5/resolve/main/text_encoders/gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors",
        "size": 15372969374
      },
      {
        "name": "ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors",
        "directory": "diffusion_models",
        "url": "https://huggingface.co/Lightricks/LTX-2.5/resolve/main/diffusion_models/ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors",
        "size": 21504034224
      },
      {
        "name": "ltx-2.5-audio-vae-bf16.safetensors",
        "directory": "vae",
        "url": "https://huggingface.co/Lightricks/LTX-2.5/resolve/main/vae/ltx-2.5-audio-vae-bf16.safetensors",
        "size": 364866540
      },
      {
        "name": "ltx-2.5-latent-spatial-upscaler-x2-bf16-1.0.safetensors",
        "directory": "latent_upscale_models",
        "url": "https://huggingface.co/Lightricks/LTX-2.5/resolve/main/latent_upscale_models/ltx-2.5-latent-spatial-upscaler-x2-bf16-1.0.safetensors",
        "size": 995778752
      },
      {
        "name": "ltx-2.5-video-vae-bf16.safetensors",
        "directory": "vae",
        "url": "https://huggingface.co/Lightricks/LTX-2.5/resolve/main/vae/ltx-2.5-video-vae-bf16.safetensors",
        "size": 1472223346
      }
    ]
  },
  "sources": [
    "https://github.com/Comfy-Org/workflow_templates/blob/main/templates/video_ltx2_5_t2v.json",
    "https://docs.comfy.org/tutorials/video/ltx/ltx-2-5",
    "https://huggingface.co/Lightricks/LTX-2.5"
  ],
  "tags": ["audio"]
}
