{
  "schema": 1,
  "name": "Wan 2.2 5B",
  "description": "Alibaba Wan 2.2 TI2V 5B: text to video, or image to video when a start frame is given, at 24 fps and up to 720p. About 18 GB of weights; runs on 8 to 12 GB GPUs with ComfyUI offloading.",
  "vendor": "Alibaba",
  "output": "video",
  "tasks": ["text_to_video", "image_to_video"],
  "open_weights": true,
  "license": "Apache-2.0",
  "prompt": [["2", "text"]],
  "negative_prompt": [["3", "text"]],
  "inputs": [
    {
      "role": "start_frame",
      "kind": "image",
      "nodes": ["10"],
      "input": "image",
      "min": 0,
      "label": "Start frame (optional)"
    }
  ],
  "params": [
    {
      "key": "aspect_ratio",
      "label": "Aspect ratio",
      "type": "enum",
      "options": [
        {
          "value": "auto",
          "label": "Match input"
        },
        {
          "value": "16:9",
          "label": "16:9"
        },
        {
          "value": "9:16",
          "label": "9:16"
        },
        {
          "value": "1:1",
          "label": "1:1"
        }
      ],
      "default": "auto"
    },
    {
      "key": "duration",
      "label": "Duration",
      "type": "enum",
      "options": [
        {
          "value": 2,
          "label": "2s"
        },
        {
          "value": 3,
          "label": "3s"
        },
        {
          "value": 4,
          "label": "4s"
        },
        {
          "value": 5,
          "label": "5s"
        }
      ],
      "default": 5,
      "bind": [
        {
          "node": "9",
          "input": "length",
          "frames": {
            "fps": 24,
            "step": 4,
            "offset": 1
          }
        }
      ]
    },
    {
      "key": "steps",
      "label": "Steps",
      "type": "int",
      "min": 1,
      "max": 50,
      "default": 20,
      "advanced": true,
      "bind": [["1", "steps"]]
    },
    {
      "key": "guidance",
      "label": "Guidance",
      "type": "float",
      "min": 1,
      "max": 10,
      "step": 0.1,
      "default": 5,
      "advanced": true,
      "bind": [["1", "cfg"]]
    },
    {
      "key": "seed",
      "label": "Seed",
      "type": "seed",
      "advanced": true,
      "bind": [["1", "seed"]]
    }
  ],
  "size": {
    "width": [["9", "width"]],
    "height": [["9", "height"]],
    "megapixels": 0.86,
    "multiple": 32,
    "match_input": "start_frame"
  },
  "max_outputs": 1,
  "outputs": ["12"],
  "requires": {
    "nodes": [
      "CLIPLoader",
      "CLIPTextEncode",
      "CreateVideo",
      "KSampler",
      "LoadImage",
      "ModelSamplingSD3",
      "SaveVideo",
      "UNETLoader",
      "VAEDecode",
      "VAELoader",
      "Wan22ImageToVideoLatent"
    ],
    "models": [
      {
        "name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
        "directory": "text_encoders",
        "url": "https://huggingface.co/Comfy-Org/Wan_2.1_ComfyUI_repackaged/resolve/main/split_files/text_encoders/umt5_xxl_fp8_e4m3fn_scaled.safetensors",
        "size": 6735906897,
        "sha256": "c3355d30191f1f066b26d93fba017ae9809dce6c627dda5f6a66eaa651204f68"
      },
      {
        "name": "wan2.2_ti2v_5B_fp16.safetensors",
        "directory": "diffusion_models",
        "url": "https://huggingface.co/Comfy-Org/Wan_2.2_ComfyUI_Repackaged/resolve/main/split_files/diffusion_models/wan2.2_ti2v_5B_fp16.safetensors",
        "size": 9999658848,
        "sha256": "456f901338bd9eadbded3828b819109a9b68e8a525ca5cf8d0049a69fcfeca1e"
      },
      {
        "name": "wan2.2_vae.safetensors",
        "directory": "vae",
        "url": "https://huggingface.co/Comfy-Org/Wan_2.2_ComfyUI_Repackaged/resolve/main/split_files/vae/wan2.2_vae.safetensors",
        "size": 1409400960,
        "sha256": "e40321bd36b9709991dae2530eb4ac303dd168276980d3e9bc4b6e2b75fed156"
      }
    ]
  },
  "sources": [
    "https://github.com/Comfy-Org/workflow_templates/blob/main/templates/video_wan2_2_5B_ti2v.json",
    "https://docs.comfy.org/tutorials/video/wan/wan2_2",
    "https://huggingface.co/Comfy-Org/Wan_2.2_ComfyUI_Repackaged"
  ]
}
